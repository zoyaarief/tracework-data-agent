# The API works in deterministic demo mode without a key.
TRACEWORK_OPENAI_API_KEY=
TRACEWORK_OPENAI_MODEL=gpt-5-mini
TRACEWORK_DATABASE_URL=sqlite:///./backend/data/commerce.db
TRACEWORK_MAX_AGENT_STEPS=8
TRACEWORK_MAX_QUERY_ROWS=200
TRACEWORK_QUERY_TIMEOUT_SECONDS=8
TRACEWORK_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
